# IsThereAnyDeal API Key
# https://isthereanydeal.com/dev/app/ 에서 발급
IS_THERE_ANY_DEAL_API_KEY = your_itad_api_key_here

# Steam Web API Key
# https://steamcommunity.com/dev/apikey 에서 발급
STEAM_WEB_API_KEY = your_steam_api_key_here

# Naver Shopping API
# https://developers.naver.com/apps/ 에서 발급
NAVER_CLIENT_ID = your_naver_client_id_here
NAVER_CLIENT_SECRET = your_naver_client_secret_here

# GMS API Key (SSAFY 제공)
GMS_API_KEY = your_gms_api_key_here

# Django production settings
SECRET_KEY = replace_with_a_long_random_secret
DEBUG = False
ALLOWED_HOSTS = your-render-service.onrender.com
CSRF_TRUSTED_ORIGINS = https://your-render-service.onrender.com
CORS_ALLOWED_ORIGINS = https://your-render-service.onrender.com
LOAD_FIXTURES_ON_DEPLOY = false
